@StunningBuilder.Api_HostAddress = http://localhost:5176
@AppId = 00000000-0000-0000-0000-000000000000

### System Health Check (PostgreSQL & Redis)
GET {{StunningBuilder.Api_HostAddress}}/health
Accept: application/json

### Get Supported Integrations
GET {{StunningBuilder.Api_HostAddress}}/api/v1/integrations
Accept: application/json

### List All Apps
GET {{StunningBuilder.Api_HostAddress}}/api/v1/apps?page=1&pageSize=10
Accept: application/json

### Create New App
POST {{StunningBuilder.Api_HostAddress}}/api/v1/apps
Content-Type: application/json

{
  "name": "My Stunning Store",
  "description": "An AI-powered e-commerce storefront with Stripe and Shopify integration.",
  "template": "ecommerce",
  "framework": "nextjs"
}

### AI Generate App Scaffold (Direct JSON)
POST {{StunningBuilder.Api_HostAddress}}/api/v1/generate
Content-Type: application/json

{
  "prompt": "Create a modern fitness subscription app with Stripe recurring billing and workout trackers",
  "template": "saas",
  "framework": "nextjs",
  "requestedIntegrations": ["stripe", "slack"]
}

### AI Stream App Scaffold (Server-Sent Events)
POST {{StunningBuilder.Api_HostAddress}}/api/v1/generate/stream
Content-Type: application/json
Accept: text/event-stream

{
  "prompt": "Create a modern real estate marketplace with Google Sheets lead sync",
  "template": "ecommerce",
  "framework": "nextjs",
  "requestedIntegrations": ["google-sheets"]
}

### Get OpenAPI Specification
GET {{StunningBuilder.Api_HostAddress}}/openapi/v1.json
Accept: application/json
